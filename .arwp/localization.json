{
  "$schema": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/localization-profile.schema.json",
  "version": "0.2",
  "site": "https://brali-lifeos.github.io/",
  "sourceLocale": "en",
  "defaultLocale": "en",
  "fallbackPolicy": "explicit-by-surface-no-silent-human-fallback",
  "glossaryFile": "data/localization/glossary.json",
  "debtLedger": "data/localization/quality-debt.json",
  "sitemapManifestPattern": "{locale}/sitemap.xml",
  "localeManifestPattern": "{locale}/manifest.json",
  "localeLlmsPattern": "{locale}/llms.txt",
  "xDefaultPolicy": "source-locale",
  "releaseContract": {
    "coverage": "exact-for-published-human-interface",
    "qualityStateIndependentFromEvidence": true,
    "realBrowserRequired": true,
    "noSilentHumanFallback": true,
    "secondaryHumanSurfacePolicy": "explicit-source-locale-boundary-until-localized",
    "referenceImplementation": "ru"
  },
  "locales": [
    {
      "code": "en",
      "languageTag": "en",
      "label": "English",
      "direction": "ltr",
      "routePrefix": "/",
      "role": "canonical",
      "status": "published",
      "markets": [],
      "searchPublication": "full"
    },
    {
      "code": "ru",
      "languageTag": "ru",
      "label": "Русский",
      "direction": "ltr",
      "routePrefix": "/ru/",
      "datasetRoot": "data/localization/ru",
      "role": "human-interface",
      "status": "reviewed-partial",
      "markets": [],
      "searchPublication": "limited",
      "requiredGates": [
        "scripts/check-localization-contract.mjs",
        "scripts/check-localizations.mjs",
        "scripts/check-ru-library.mjs",
        "scripts/audit-ru-language.mjs",
        "scripts/check-ru-primary-pages.mjs",
        "scripts/check-browser-localizations.mjs",
        "scripts/check-live-localizations.mjs"
      ],
      "releaseProof": ["contract", "corpus", "language", "rendered", "browser", "live"]
    },
    {
      "code": "de",
      "languageTag": "de",
      "browserLocale": "de-DE",
      "label": "Deutsch",
      "direction": "ltr",
      "routePrefix": "/de/",
      "datasetRoot": "data/localization/de",
      "role": "human-interface",
      "status": "reviewed-partial",
      "markets": [],
      "searchPublication": "limited",
      "requiredGates": [
        "scripts/check-localization-contract.mjs",
        "scripts/check-de-library-contract.mjs",
        "scripts/audit-de-library-language.mjs",
        "scripts/check-hreflang-graph.mjs",
        "scripts/check-browser-localizations.mjs",
        "scripts/check-live-localizations.mjs"
      ],
      "releaseProof": ["contract", "corpus", "language", "rendered", "browser", "live"]
    }
  ],
  "markets": [],
  "surfaces": [
    {
      "id": "core-ui",
      "kind": "rendered-page-manifest",
      "parity": "adapted",
      "canonicalSource": "index.html",
      "localePattern": "{locale}/index.html",
      "membership": "subset",
      "requiredForRoles": ["human-interface"],
      "requireNfc": true,
      "checks": ["localized-navigation", "localized-accessible-names", "no-silent-fallback"]
    },
    {
      "id": "flagship-content",
      "kind": "json-record-set",
      "parity": "semantic",
      "canonicalSource": "life-os/datasets/flagships.json",
      "localePattern": "data/localization/{locale}/flagships.json",
      "stableIdField": "slug",
      "sourceHashField": "sourceFingerprint",
      "membership": "exact",
      "requiredFields": ["slug", "title", "description", "action", "check_in", "evidence_status", "sourceFingerprint"],
      "valueFields": ["title", "description", "action", "check_in", "boundary", "alternative"],
      "requiredForRoles": ["human-interface"],
      "checks": ["exact-id-parity", "required-fields", "source-current", "evidence-state-preserved"]
    },
    {
      "id": "library-content",
      "kind": "json-record-set",
      "parity": "semantic",
      "canonicalSource": "data/life-os-content/index.json",
      "localePattern": "data/localization/{locale}/library/*.json",
      "stableIdField": "slug",
      "membership": "subset",
      "requiredFields": ["slug", "title", "subtitle", "description", "quality_state", "source"],
      "valueFields": ["title", "subtitle", "description", "action", "check_in", "boundary", "alternative"],
      "requiredForRoles": ["human-interface"],
      "checks": ["stable-identity", "source-current", "quality-state-explicit", "evidence-state-derived-not-translated", "no-silent-fallback"]
    },
    {
      "id": "growth-zones",
      "kind": "json-record-set",
      "parity": "semantic",
      "canonicalSource": "data/life-os-zones.json",
      "localePattern": "data/localization/{locale}/zones.json",
      "stableIdField": "slug",
      "membership": "exact",
      "requiredFields": ["slug", "title", "subtitle"],
      "valueFields": ["title", "subtitle"],
      "requiredForRoles": ["human-interface"],
      "checks": ["exact-id-parity", "natural-localized-copy"]
    },
    {
      "id": "methodology",
      "kind": "rendered-page-manifest",
      "parity": "semantic",
      "canonicalSource": "life-os/methodology/index.html",
      "localePattern": "{locale}/life-os/methodology/index.html",
      "membership": "subset",
      "requiredForRoles": ["human-interface"],
      "checks": ["trust-state-semantics", "recommendation-boundary-preserved"]
    },
    {
      "id": "research-hub",
      "kind": "rendered-page-manifest",
      "parity": "semantic",
      "canonicalSource": "research/index.html",
      "localePattern": "{locale}/research/index.html",
      "membership": "exact",
      "requiredForRoles": ["human-interface"],
      "checks": ["source-current", "native-localized-copy", "explicit-human-fallback", "reciprocal-hreflang"]
    },
    {
      "id": "partners-hub",
      "kind": "rendered-page-manifest",
      "parity": "adapted",
      "canonicalSource": "partners/index.html",
      "localePattern": "{locale}/partners/index.html",
      "membership": "exact",
      "requiredForRoles": ["human-interface"],
      "checks": ["source-current", "native-localized-copy", "explicit-human-fallback", "reciprocal-hreflang"]
    },
    {
      "id": "ai-developer-hub",
      "kind": "rendered-page-manifest",
      "parity": "adapted",
      "canonicalSource": "for-ai/index.html",
      "localePattern": "{locale}/for-ai/index.html",
      "membership": "exact",
      "requiredForRoles": ["human-interface"],
      "checks": ["source-current", "native-localized-copy", "machine-contract-preserved", "explicit-human-fallback", "reciprocal-hreflang"]
    },
    {
      "id": "accessibility",
      "kind": "manual",
      "parity": "adapted",
      "requiredForRoles": ["human-interface"],
      "checks": ["localized-accessible-names", "localized-skip-link", "narrow-layout-review"]
    },
    {
      "id": "seo-search",
      "kind": "rendered-page-manifest",
      "parity": "adapted",
      "canonicalSource": "sitemap.xml",
      "localePattern": "{locale}/sitemap.xml",
      "membership": "subset",
      "requiredForRoles": ["human-interface"],
      "requireHreflang": true,
      "requireSitemap": true,
      "requireSearchMetadata": true,
      "requireStructuredDataLanguage": true,
      "checks": ["html-lang", "self-canonical", "reciprocal-hreflang", "sitemap-membership", "structured-data-language"]
    },
    {
      "id": "ai-agent",
      "kind": "machine-files",
      "parity": "semantic",
      "localePattern": "{locale}/llms.txt",
      "requiredForRoles": ["human-interface"],
      "requiredTokenTemplates": ["Locale: {locale}", "Canonical locale: {sourceLocale}", "No silent fallback: true"],
      "checks": ["declared-machine-surface", "locale-routing-semantics", "coverage-boundary-visible"]
    }
  ],
  "impactRules": [
    {"paths":["index.html","homepage.js","styles.css","scripts/apply-brand-shell.mjs","scripts/patch-localized-responsive-css.mjs"],"surfaces":["core-ui","accessibility","seo-search"]},
    {"paths":["life-os/datasets/flagships.json","scripts/build-flagship-collection.mjs","scripts/build-protocol-feed.mjs"],"surfaces":["flagship-content","seo-search","ai-agent"]},
    {"paths":["data/life-os-content/index.json","data/life-os-content/**","life-os/datasets/evidence.json"],"surfaces":["library-content","seo-search","ai-agent"]},
    {"paths":["data/life-os-zones.json"],"surfaces":["growth-zones","seo-search"]},
    {"paths":["scripts/build-content-methodology.mjs","life-os/methodology/index.html"],"surfaces":["methodology","seo-search","ai-agent"]},
    {"paths":["research/index.html"],"surfaces":["research-hub","seo-search"]},
    {"paths":["partners/index.html"],"surfaces":["partners-hub","seo-search"]},
    {"paths":["for-ai/index.html"],"surfaces":["ai-developer-hub","seo-search","ai-agent"]},
    {"paths":["data/localization/**"],"surfaces":["core-ui","flagship-content","library-content","growth-zones","methodology","research-hub","partners-hub","ai-developer-hub","accessibility","seo-search","ai-agent"]},
    {"paths":["scripts/build-localizations.mjs","scripts/build-ru-primary-pages.mjs","scripts/build-ru-library.mjs","scripts/patch-ru-discovery.mjs","scripts/check-localizations.mjs","scripts/check-ru-library.mjs","scripts/check-ru-primary-pages.mjs","scripts/check-localization-contract.mjs","scripts/check-localization-faults.mjs","scripts/audit-ru-language.mjs","scripts/check-browser-localizations.mjs","scripts/check-live-localizations.mjs","scripts/run-localization-release-gates.mjs","scripts/build-profile-locales.mjs","scripts/normalize-localization-hreflang.mjs","scripts/check-hreflang-graph.mjs","scripts/check-de-library-contract.mjs","scripts/audit-de-library-language.mjs"],"surfaces":["core-ui","flagship-content","library-content","growth-zones","methodology","research-hub","partners-hub","ai-developer-hub","accessibility","seo-search","ai-agent"]}
  ],
  "evidenceBoundary": "A passing Brali localization gate proves declared source, generated-page and machine-surface invariants for the published locale scope. It does not by itself prove literary quality, cultural fit, deployed indexing, ranking, AI citation, recommendation visibility, traffic or conversion. Localization quality state is tracked separately from canonical evidence state."
}
