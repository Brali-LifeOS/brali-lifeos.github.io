{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brali-lifeos.github.io/contracts/agent-loop-plan.schema.json",
  "title": "Brali Product Outcome Loop Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "canonical_issue_repo",
    "product_positioning",
    "product_boundary",
    "value_chain",
    "north_star",
    "wip_limits",
    "gates",
    "workstreams",
    "stop_rules",
    "run_protocol",
    "external_blocker_policy"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date" },
    "canonical_issue_repo": { "type": "string", "format": "uri" },
    "product_positioning": { "type": "string", "minLength": 30 },
    "product_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "legacy"],
      "properties": {
        "primary": { "type": "string", "minLength": 10 },
        "secondary": { "type": "string", "minLength": 10 },
        "legacy": { "type": "string", "minLength": 10 }
      }
    },
    "value_chain": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "north_star": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definition", "collection_status", "initial_validation_target", "target_type", "anti_metrics"],
      "properties": {
        "id": { "const": "weekly_verified_successful_executions" },
        "definition": { "type": "string", "minLength": 40 },
        "collection_status": { "enum": ["not-collected", "instrumented", "observed"] },
        "initial_validation_target": { "type": "integer", "minimum": 1 },
        "target_type": { "const": "hypothesis" },
        "anti_metrics": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "wip_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_prs", "active_implementation_slices", "active_editorial_reviews"],
      "properties": {
        "implementation_prs": { "type": "integer", "minimum": 1, "maximum": 2 },
        "active_implementation_slices": { "type": "integer", "minimum": 1, "maximum": 2 },
        "active_editorial_reviews": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/gate" }
    },
    "workstreams": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/workstream" }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 20 }
    },
    "run_protocol": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string", "minLength": 20 }
    },
    "external_blocker_policy": { "type": "string", "minLength": 60 }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "status", "issue_numbers", "exit_criteria"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "order": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 5 },
        "status": { "enum": ["active", "queued", "blocked", "awaiting-external", "completed"] },
        "issue_numbers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "exit_criteria": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 15 }
        }
      }
    },
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "issue_number",
        "issue_url",
        "priority",
        "lane",
        "gate",
        "status",
        "depends_on",
        "next_slice",
        "completion_evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "issue_number": { "type": "integer", "minimum": 1 },
        "issue_url": { "type": "string", "format": "uri" },
        "priority": { "enum": ["P0", "P1", "P2"] },
        "lane": { "enum": ["implementation", "editorial", "external", "decision"] },
        "gate": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "status": { "enum": ["active", "queued", "blocked", "awaiting-external", "completed"] },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "next_slice": { "type": "string", "minLength": 20 },
        "completion_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 5 }
        }
      }
    }
  }
}
