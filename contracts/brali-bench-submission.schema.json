{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brali-lifeos.github.io/bench/schema/submission.schema.json",
  "title": "Brali Bench third-party submission",
  "type": "object",
  "required": ["schema_version", "bench_version", "system", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "bench_version": {"type": "string", "minLength": 1},
    "system": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "configuration": {"type": ["string", "null"]}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "topic_ids": {"type": "array", "items": {"type": "string"}},
          "protocol_slugs": {"type": "array", "items": {"type": "string"}},
          "canonical_protocol_ids": {"type": "array", "items": {"type": "string"}},
          "protocol_evidence_states": {"type": "object", "additionalProperties": {"type": "string"}},
          "evidence_decision_ids": {"type": "array", "items": {"type": "string"}},
          "no_answer": {"type": "boolean"},
          "provenance_preserved": {"type": "boolean"},
          "unsupported_claims": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
