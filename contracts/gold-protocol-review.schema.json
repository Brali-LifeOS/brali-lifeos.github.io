{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brali-lifeos.github.io/contracts/gold-protocol-review.schema.json",
  "title": "Brali Gold Protocol Manual Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "slug",
    "reviewed_at",
    "reviewed_by",
    "review_status",
    "user_problem",
    "eligibility",
    "when_not_to_use",
    "first_action",
    "steps",
    "review_horizon",
    "observable_signal",
    "stop_or_change_rule",
    "fallback",
    "evidence_boundary",
    "limitations",
    "citation",
    "agent_summary",
    "retrieval_paths",
    "evaluation_case_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_id": {"type": "string", "pattern": "^brali:[a-z0-9-]+$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "reviewed_at": {"type": "string", "format": "date"},
    "reviewed_by": {"type": "string", "minLength": 3},
    "review_status": {"enum": ["gold-ready", "rework", "reject"]},
    "user_problem": {"type": "string", "minLength": 20},
    "eligibility": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
    "when_not_to_use": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
    "first_action": {"type": "string", "minLength": 10},
    "steps": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 8}},
    "review_horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rationale"],
      "properties": {
        "value": {"type": "string", "minLength": 3},
        "rationale": {"type": "string", "minLength": 15}
      }
    },
    "observable_signal": {"type": "string", "minLength": 12},
    "stop_or_change_rule": {"type": "string", "minLength": 15},
    "fallback": {"type": "string", "minLength": 12},
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "statement", "source_decision_ids"],
      "properties": {
        "status": {"enum": ["reviewed", "practical"]},
        "statement": {"type": "string", "minLength": 20},
        "source_decision_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_protocol_url", "source_citations"],
      "properties": {
        "canonical_protocol_url": {"type": "string", "format": "uri"},
        "source_citations": {"type": "array", "items": {"type": "string", "minLength": 5}}
      }
    },
    "agent_summary": {"type": "string", "minLength": 30},
    "retrieval_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "evaluation_case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
  }
}
