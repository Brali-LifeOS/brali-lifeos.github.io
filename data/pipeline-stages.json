{
  "schema_version": 1,
  "name": "Brali staged repository gate",
  "purpose": "Expose the existing full build and check chains as named stages without weakening or reordering the canonical package.json gate.",
  "report_schema_version": 1,
  "groups": {
    "build": [
      "build-source",
      "build-knowledge",
      "build-platform",
      "build-evaluation",
      "build-adoption"
    ],
    "check": [
      "check-source",
      "check-knowledge",
      "check-retrieval",
      "check-adoption",
      "check-integration"
    ],
    "supplemental": [
      "check-outcomes",
      "check-control-plane"
    ],
    "all": [
      "build-source",
      "build-knowledge",
      "build-platform",
      "build-evaluation",
      "build-adoption",
      "check-source",
      "check-knowledge",
      "check-retrieval",
      "check-adoption",
      "check-integration",
      "check-outcomes",
      "check-control-plane"
    ]
  },
  "stages": [
    {
      "id": "build-source",
      "phase": "build",
      "description": "Apply editorial registries and generate the human-facing LifeOS source layer.",
      "canonical_parity": true,
      "commands": [
        "node scripts/apply-review-registry.mjs",
        "node scripts/apply-protocol-content-overrides.mjs",
        "node scripts/apply-editorial-normalizations.mjs",
        "node scripts/build-life-os.mjs",
        "node scripts/render-source-references.mjs",
        "node scripts/normalize-generated-titles.mjs",
        "node scripts/enhance-library-search.mjs",
        "node scripts/build-life-areas.mjs"
      ]
    },
    {
      "id": "build-knowledge",
      "phase": "build",
      "description": "Generate ontology, evidence, indexing, protocol, coverage and methodology surfaces.",
      "canonical_parity": true,
      "commands": [
        "node scripts/build-knowledge-ontology.mjs",
        "node scripts/enhance-structured-data.mjs",
        "node scripts/build-evidence-index.mjs",
        "node scripts/apply-indexing-policy.mjs",
        "node scripts/build-protocol-feed.mjs",
        "node scripts/build-ontology-coverage.mjs",
        "node scripts/build-flagship-collection.mjs",
        "node scripts/enhance-homepage-flagships.mjs",
        "node scripts/publish-editorial-normalizations.mjs",
        "node scripts/build-content-methodology.mjs",
        "node scripts/build-claim-debt-report.mjs",
        "node scripts/add-related-protocols.mjs",
        "node scripts/sanitize-generated.mjs"
      ]
    },
    {
      "id": "build-platform",
      "phase": "build",
      "description": "Generate API, identity, manifest, integration and platform retrieval surfaces.",
      "canonical_parity": true,
      "commands": [
        "node scripts/build-platform.mjs",
        "node scripts/refine-platform-retrieval.mjs",
        "node scripts/finalize-platform.mjs"
      ]
    },
    {
      "id": "build-evaluation",
      "phase": "build",
      "description": "Build the high-trust collection, evaluation suite, Topic Hubs and reference demos.",
      "canonical_parity": true,
      "commands": [
        "node scripts/build-flagship-100.mjs",
        "node scripts/run-agent-evaluation.mjs",
        "node scripts/build-topic-hubs.mjs",
        "node scripts/build-reference-agent-demos.mjs"
      ]
    },
    {
      "id": "build-adoption",
      "phase": "build",
      "description": "Build Query, adoption, outcome, sitemap and next-editorial-batch surfaces.",
      "canonical_parity": true,
      "commands": [
        "node scripts/build-query-playground.mjs",
        "node scripts/build-adoption-surfaces.mjs",
        "node scripts/run-query-parity.mjs",
        "node scripts/build-query-adoption-funnel.mjs",
        "node scripts/extend-sitemap.mjs",
        "node scripts/build-claim-cleanup-batch.mjs"
      ]
    },
    {
      "id": "check-source",
      "phase": "check",
      "description": "Validate claim taxonomy, site structure, source rendering, overrides and search.",
      "canonical_parity": true,
      "commands": [
        "node scripts/apply-review-registry.mjs",
        "node scripts/check-claim-taxonomy.mjs",
        "node --check library-search.js",
        "node scripts/check-site.mjs",
        "node scripts/check-editorial-normalizations.mjs",
        "node scripts/check-protocol-content-overrides.mjs",
        "node scripts/check-source-references.mjs",
        "node scripts/check-library-search.mjs"
      ]
    },
    {
      "id": "check-knowledge",
      "phase": "check",
      "description": "Validate ontology, structure, indexing, protocol, coverage and evidence-sensitive collections.",
      "canonical_parity": true,
      "commands": [
        "node scripts/check-knowledge-ontology.mjs",
        "node scripts/check-structured-data.mjs",
        "node scripts/check-indexing-policy.mjs",
        "node scripts/check-protocol-feed.mjs",
        "node scripts/check-ontology-coverage.mjs",
        "node scripts/check-sleep-memory-research.mjs",
        "node scripts/check-retrieval-practice-boundary.mjs",
        "node scripts/check-flagship-collection.mjs",
        "node scripts/check-flagship-100.mjs"
      ]
    },
    {
      "id": "check-retrieval",
      "phase": "check",
      "description": "Validate agent evaluation, Topic Hubs, reference demos and browser Query parity.",
      "canonical_parity": true,
      "commands": [
        "node scripts/check-agent-evaluation.mjs",
        "node scripts/check-topic-hubs.mjs",
        "node scripts/check-coverage-gap-closures.mjs",
        "node scripts/check-reference-agent-demos.mjs",
        "node --check scripts/build-query-playground.mjs",
        "node --check scripts/run-query-parity.mjs",
        "node --check scripts/check-query-parity.mjs",
        "node --check scripts/build-query-adoption-funnel.mjs",
        "node --check scripts/check-query-adoption-funnel.mjs",
        "node --check for-ai/query/app.js",
        "node --check for-ai/query/retrieval.mjs",
        "node scripts/check-query-playground.mjs",
        "node scripts/check-query-parity.mjs",
        "node scripts/check-query-adoption-funnel.mjs"
      ]
    },
    {
      "id": "check-adoption",
      "phase": "check",
      "description": "Validate adoption, methodology, claim debt and deterministic cleanup history.",
      "canonical_parity": true,
      "commands": [
        "node --check scripts/build-adoption-surfaces.mjs",
        "node --check scripts/check-adoption-surfaces.mjs",
        "node --check examples/integrations/openai-api.mjs",
        "node scripts/check-adoption-surfaces.mjs",
        "node scripts/check-content-methodology.mjs",
        "node scripts/check-claim-debt-report.mjs",
        "node scripts/check-claim-cleanup-batch.mjs",
        "node scripts/check-claim-cleanup-decisions.mjs"
      ]
    },
    {
      "id": "check-integration",
      "phase": "check",
      "description": "Validate related data, platform contract, releases, MCP, research providers and strict content quality.",
      "canonical_parity": true,
      "commands": [
        "node scripts/check-related-protocols.mjs",
        "node scripts/check-platform-v2.mjs",
        "node --check scripts/package-data-release.mjs",
        "node --check scripts/check-data-release.mjs",
        "node --check mcp/server.mjs",
        "node scripts/check-mcp-contract.mjs",
        "npm run mcp:package",
        "python3 scripts/check-research-system.py",
        "python3 scripts/check-research-providers.py",
        "node scripts/check-sitewide-quality-loop.mjs",
        "node scripts/audit-content.mjs --strict"
      ]
    },
    {
      "id": "check-outcomes",
      "phase": "supplemental",
      "description": "Validate outcome schema, explicit privacy boundary, zero-state reporting and Query feedback export.",
      "canonical_parity": false,
      "commands": [
        "node scripts/check-outcome-surfaces.mjs"
      ]
    },
    {
      "id": "check-control-plane",
      "phase": "supplemental",
      "description": "Validate the product outcome loop and current execution control plane.",
      "canonical_parity": false,
      "commands": [
        "python3 scripts/check-agent-loop.py"
      ]
    }
  ],
  "rules": {
    "canonical_build_script": "build",
    "canonical_check_script": "check",
    "fail_fast": true,
    "preserve_command_order": true,
    "supplemental_checks_may_not_replace_canonical_commands": true,
    "report_must_mark_observed_and_planned_values_separately": true
  }
}
