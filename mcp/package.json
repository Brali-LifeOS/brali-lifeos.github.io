{
  "name": "brali-knowledge-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for Brali's evidence-aware practical knowledge library.",
  "type": "module",
  "license": "CC-BY-NC-SA-4.0",
  "homepage": "https://brali-lifeos.github.io/for-ai/integrations/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brali-LifeOS/brali-lifeos.github.io.git",
    "directory": "mcp"
  },
  "mcpName": "io.github.dkharlanau/brali-knowledge",
  "engines": {"node": ">=20"},
  "bin": {
    "brali-knowledge-mcp": "./server.mjs"
  },
  "files": [
    "server.mjs",
    "server.json",
    "README.md",
    "dist-data/**"
  ],
  "scripts": {
    "start": "node server.mjs",
    "prepare:data": "node prepare-package.mjs",
    "check": "node --check server.mjs && node check-package.mjs",
    "prepack": "node prepare-package.mjs && node check-package.mjs"
  },
  "publishConfig": {"access": "public"},
  "keywords": ["mcp", "model-context-protocol", "knowledge", "evidence", "ai-agents", "brali"],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  }
}
